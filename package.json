{
  "name": "stasium",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "dev": "vite",
    "dev:cli": "bun run index.ts",
    "build": "bun run build:cli && bun run build:site",
    "build:cli": "bun build ./index.ts --compile --outfile ./dist/stasium",
    "build:site": "tsc -p tsconfig.site.json && vite build",
    "lint": "oxlint --quiet .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "bun run test:cli && bun run test:site",
    "test:cli": "bun test src",
    "test:site": "vitest run",
    "init:hooks": "bun ./scripts/install-githooks.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@fontsource-variable/instrument-sans": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@opentui/core": "^0.1.79",
    "@tailwindcss/vite": "^4.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__core": "^7.20.5",
    "@types/bun": "latest",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "jsdom": "^29.1.1",
    "oxfmt": "latest",
    "oxlint": "latest",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  }
}
